@component('components/layout', { title: title })
    <div class="naming">
  <form action="{{ route('deck.update', { id: deck.id }) }}" method="POST">
    {{ csrfField() }}
    <input type="hidden" name="_method" value="PUT" />
    {{-- Bloc Name --}}

    <div class="field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" value="{{ old('name') || deck.name }}" />
      @inputError('name')
        <p class="text-danger">
          {{ $messages.join(', ') }}
        </p>
      @end
    </div>
    {{-- Bloc Description --}}
    <div class="field">
      <label for="description">Description</label>
      <textarea
        type="text"
        id="description"
        name="description"
        >{{ old('description') || deck.description }}"</textarea>
      @inputError('description')
        <p class="text-danger">
          {{ $messages.join(', ') }}
        </p>
      @end
    </div>
    <div class="buttons">
    <button class="add-button" type="submit">Enregistrer</button>
    <button class="add-button" type="button" onclick="window.location.href='{{ route('deck.show', {id:deck.id}) }}'">Annuler</button>
    </div>
  </form>
    </div>
@endcomponent

