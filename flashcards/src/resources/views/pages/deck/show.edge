@component('components/layout', { title: title })
  <div class="container">
    <div class="buttons-section">
      <div class="start-button">
        <form action="{{ route('play.show', { id: deck.id }) }}" method="GET">
          <button class="add-button" type="submit">Jouer avec ce deck</button>
        </form>
      </div>
      <div class="action-buttons">
        <form action="{{ route('deck.edit', { id: deck.id }) }}" method="GET">
          <button class="add-button" type="submit">Modifier le deck</button>
        </form>
        <form
          action="{{ route('deck.destroy', { id: deck.id }) }}"
          method="POST"
          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer le deck « {{ deck.name }} » ?')"
        >
          {{ csrfField() }}
          <button class="add-button" type="submit">Supprimer le deck</button>
        </form>
      </div>
    </div>
    <div>
      <h1>
        {{ deck.name }}
      </h1>
      <p class="description">
        {{ deck.description }}
      </p>
    </div>
    <table class="deck-table">
      <tr>
        <th>
          Question
        </th>
        <th>
          Réponse
        </th>
        <th>
          Options
        </th>
      </tr>
      @each(card in cards)
        <tr>
          <td>
            {{ card.front }}
          </td>
          <td>
            {{ card.back }}
          </td>
          <td class="options-cell">
            <div class="options-wrapper">
              <form action="{{ route('card.edit', { id: card.id }) }}" method="GET">
                <button class="add-button" type="submit">Modifier</button>
              </form>
              <form
                action="{{ route('card.destroy', { id: card.id }) }}"
                method="POST"
                onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette carte ?')"
              >
                {{ csrfField() }}
                <button class="add-button" type="submit">Supprimer</button>
              </form>
            </div>
          </td>
        </tr>
      @end
    </table>
  </div>

  <form action="{{ route('card.create', { id: deck.id }) }}" method="GET">
    <button class="add-button" type="submit">Ajouter une carte</button>
  </form>

  <style>
    .container {
      width: 1000px;
      margin: 0 auto;
      font-family: sans-serif;
    }
    
    .deck-table th:nth-child(3),
    .deck-table td.options-cell {
      width: 1px;
      white-space: nowrap;
      padding: 8px;
    }
    
    .options-cell button {
      margin-top: 0;
    }
    
    .options-wrapper {
      display: flex;
      gap: 10px;
      justify-content: center;
    }
    
    .options {
      display: flex;
      gap: 10px;
    }
    
    h1 {
      text-align: center;
    }
    
    .buttons-section {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }
    
    .action-buttons {
      display: flex;
      gap: 10px;
    }
    
    .start-button {
      display: flex;
      gap: 10px;
    }
    
    .description {
      text-align: center;
      margin-bottom: 40px;
    }
    
    .deck-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
    }
    
    .deck-table th {
      text-align: left;
      font-size: 25px;
      padding-bottom: 20px;
      border: 1px solid #dddddd;
      padding: 8px;
    }
    
    .deck-table td {
      padding: 10px 0;
      font-size: 18px;
      border: 1px solid #dddddd;
      padding: 8px;
    }
    
    .deck-table td:first-child {
      font-weight: bold;
    }
    
    .deck-link {
      text-decoration: none;
      color: black;
    }
  </style>
@endcomponent
