@component('components/layout', { title: title })
<div class="naming">
  <form action="{{ route('card.update', { id: card.id }) }}" method="POST">
    {{ csrfField() }}
    <input type="hidden" name="_method" value="PUT" />

    {{-- Bloc Front (Question) --}}
    <div class="field">
      <label for="front">Question</label>
      <input type="text" id="front" name="front" value="{{ old('front') || card.front }}" />
      @inputError('front')
        <p class="text-danger">
          {{ $messages.join(', ') }}
        </p>
      @end
    </div>

    {{-- Bloc Back (Réponse) --}}
    <div class="field">
      <label for="back">Réponse</label>
      <textarea id="back" name="back">{{ old('back') || card.back }}</textarea>
      @inputError('back')
        <p class="text-danger">
          {{ $messages.join(', ') }}
        </p>
      @end
    </div>

    <div class="buttons">
      <button class="add-button" type="submit">Enregistrer</button>
      <button 
        class="add-button" 
        type="button" 
        onclick="window.location.href='{{ route('deck.show', { id: card.deckId }) }}'">
        Annuler
      </button>
    </div>
  </form>
</div>
@end

